digraph dependencies {
  graph [
    rankdir="TB",
    bgcolor="white",
    pad="0.3",
    nodesep="0.45",
    ranksep="0.62",
    splines="spline",
    outputorder="edgesfirst",
    fontname="DejaVu Sans",
    fontsize="17",
    fontcolor="#0F172A",
    labelloc="t",
    label="Discrepancy and local statistics of modular inverses\nMain proof branches · v39\nGreen: certified; yellow: pending certification",
  ];
  edge [color="#4b5563", arrowsize="0.65", penwidth="1.0", fontname="DejaVu Sans", fontsize="9"];
  "ov:arithmetic" [label="Arithmetic moments\nTheorem 2.1; Corollary 2.2\nProposition 2.3; Corollary 2.4", tooltip="Arithmetic moments", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:geometry" [label="Geometry and pointwise brackets\nLemmas 2.5–2.7\nCorollary 2.8; Remark 2.9", tooltip="Geometry and pointwise brackets", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:identities" [label="Counting and Fourier identities\nProposition 3.1; Remark 3.2", tooltip="Counting and Fourier identities", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:summation" [label="Dyadic summation\nLemma 4.1", tooltip="Dyadic summation", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:smoothing" [label="Convex smoothing\nProposition 4.2", tooltip="Convex smoothing", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:convex" [label="Convex discrepancy and shrinking sets\nTheorem 1.1\nCorollaries 1.2–1.3", tooltip="Convex discrepancy and shrinking sets", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:small" [label="Coordinate separation and small sets\nProposition 4.3; Corollary 4.4\nRemark 4.5", tooltip="Coordinate separation and small sets", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:boundary" [label="Controlled boundary neighborhoods\nTheorem 1.4; Corollary 4.6\nRemarks 4.7–4.8", tooltip="Controlled boundary neighborhoods", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:differences" [label="Ordered differences\nTheorem 1.5\nLemma 5.1; Corollary 5.2", tooltip="Ordered differences", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:variance" [label="Variance and exceptional sets\nTheorem 1.6; Lemma 5.3\nCorollaries 5.4–5.5", tooltip="Variance and exceptional sets", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:empty" [label="Empty rectangle and point counting\nEquation (1.6); elementary count", tooltip="Empty rectangle and point counting", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  "ov:distance" [label="Distance moments\nTheorem 1.7", tooltip="Distance moments", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1"];
  { rank="same"; "ov:arithmetic"; "ov:geometry"; "ov:identities"; }
  { rank="sink"; "ov:boundary"; "ov:differences"; "ov:distance"; }
  "ov:arithmetic" -> "ov:smoothing" [tooltip="Arithmetic shell norms enter the convex smoothing bound."];
  "ov:geometry" -> "ov:smoothing" [tooltip="Convex brackets supply the geometric shell norms and integral error."];
  "ov:identities" -> "ov:smoothing" [tooltip="The counting identity evaluates the smooth brackets."];
  "ov:smoothing" -> "ov:convex" [tooltip="Optimize the smoothing scale; then take a supremum or divide by the scaled area."];
  "ov:arithmetic" -> "ov:boundary" [tooltip="Arithmetic shells enter the separate general-boundary calculation."];
  "ov:geometry" -> "ov:boundary" [tooltip="General brackets and translation control give boundary-dependent Fourier estimates."];
  "ov:identities" -> "ov:boundary" [tooltip="The counting identity is used in the general bracket reduction."];
  "ov:summation" -> "ov:smoothing" [tooltip="Dyadic sums control the shell contributions in the convex smoothing bound."];
  "ov:summation" -> "ov:boundary" [tooltip="Use the dyadic lemma and its explicit constants; derive the near-zero exponent estimate separately."];
  "ov:arithmetic" -> "ov:differences" [tooltip="Shell and rectangular moments control squared coefficients in the difference measure."];
  "ov:geometry" -> "ov:differences" [tooltip="Convex brackets and the one-dimensional adaptation give pointwise enclosure."];
  "ov:identities" -> "ov:differences" [tooltip="The difference Fourier identity supplies the nonnegative squared coefficients."];
  "ov:summation" -> "ov:differences" [tooltip="The dyadic-summation lemma controls the smoothing sums."];
  "ov:arithmetic" -> "ov:variance" [tooltip="Squared shell and rectangular moments enter the variance estimates."];
  "ov:geometry" -> "ov:variance" [tooltip="Convex Fourier tails and pointwise coefficients are applied without smoothing."];
  "ov:identities" -> "ov:variance" [tooltip="The indicator variance identity expresses the translation variance."];
  "ov:small" -> "ov:variance" [tooltip="Coordinate separation supplies the sufficient conditions for the exact one-point identity."];
  "ov:variance" -> "ov:distance" [tooltip="The disc variance yields an empty-disc tail estimate."];
  "ov:convex" -> "ov:distance" [tooltip="Shrinking-set equidistribution gives a uniform cutoff for distance."];
  "ov:empty" -> "ov:distance" [tooltip="The elementary count and empty rectangle supply the two moment lower bounds."];
}
