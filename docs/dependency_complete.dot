digraph dependencies {
  graph [
    rankdir="TB",
    bgcolor="white",
    pad="0.3",
    nodesep="0.25",
    ranksep="0.62",
    splines="spline",
    outputorder="edgesfirst",
    fontname="DejaVu Sans",
    fontsize="17",
    fontcolor="#0F172A",
    labelloc="t",
    label="Complete documented dependencies · v39\nNumbered statements, supporting steps, and literature records\nPurple: trusted references; green: certified; yellow: pending certification",
  ];
  edge [color="#4b5563", arrowsize="0.65", penwidth="1.0", fontname="DejaVu Sans", fontsize="9"];
  "thm:perimeter" [label="Theorem 1.1\nPerimeter discrepancy\n[Pending]", tooltip="For convex sets represented inside a translated unit square, bounds discrepancy by $X^{\\varepsilon}(X^{-1}+P^{2/3}X^{-2/3})$, uniformly in the position and the set, for $X\\ge2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#thm-perimeter", target="_top"];
  "cor:isotropic" [label="Corollary 1.2\nIsotropic discrepancy\n[Pending]", tooltip="Taking the supremum over the manuscript's class of convex sets gives discrepancy $\\ll_{\\varepsilon}X^{-2/3+\\varepsilon}$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-isotropic", target="_top"];
  "cor:shrinking" [label="Corollary 1.3\nShrinking convex shapes\n[Pending]", tooltip="For a fixed convex body of positive area and $0<\\kappa<1/2$, obtains relative error $O_{K_0,\\kappa}(X^{-\\kappa})$ at dilations $t\\ge X^{-1/2+\\kappa}$ that fit inside a translated unit square, uniformly over translations and rotations.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-shrinking", target="_top"];
  "thm:boundary" [label="Theorem 1.4\nBoundary-neighborhood discrepancy\n[Pending]", tooltip="If $b_E(s)\\le Bs^{\\alpha}$ for $0<s\\le1$, $0<\\alpha\\le1$ and $B\\ge1$, gives $D_X(E)\\ll_{\\varepsilon}B^{2/(2+\\alpha)}X^{-2\\alpha/(2+\\alpha)+\\varepsilon}$ for $X\\ge2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#thm-boundary", target="_top"];
  "thm:differences" [label="Theorem 1.5\nDifference counts\n[Pending]", tooltip="The difference measure, including diagonal pairs, has discrepancy $\\ll_\\varepsilon X^\\varepsilon(PX^{-1}+X^{-2})$ for a convex set of perimeter $P$ in a translated unit square. For a product of arcs of area $V$, the bound is $\\ll_\\varepsilon X^\\varepsilon(X^{-2}+V^{2/3}X^{-5/3})$, independently of its aspect ratio.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#thm-differences", target="_top"];
  "thm:variance" [label="Theorem 1.6\nLocal variance\n[Pending]", tooltip="The variance of the normalized count is $\\ll_\\varepsilon X^\\varepsilon(P^2X^{-2}+A^{4/3}P^{2/3}X^{-5/3})$ for a convex set with area $A$ and perimeter $P$. Products of arcs satisfy $\\ll_\\varepsilon X^\\varepsilon(VX^{-2}+V^{5/3}X^{-5/3})$, and discs satisfy $\\ll_\\varepsilon X^\\varepsilon(r^2X^{-2}+r^{10/3}X^{-5/3})$. If every translate contains at most one point, the variance equals $|E|/N_X-|E|^2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#thm-variance", target="_top"];
  "thm:distance" [label="Theorem 1.7\nDistance moments\n[Pending]", tooltip="For every fixed $s>0$, the $s$-th distance moment lies between constant multiples of $X^{-\\vartheta(s)}$ and $X^{-\\vartheta(s)+\\varepsilon}$, where $\\vartheta(s)=\\min\\{s,1+s/2\\}$. Thus the exponents change at $s=2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#thm-distance", target="_top"];
  "thm:brs-input" [label="Theorem 2.1\nBRS second moment\n[Pending]", tooltip="For all real $N,X\\ge1$ and $\\eta>0$, $\\sum_{N\\le|r|<2N}|A_X(r,1)|^2\\ll_\\eta(NX)^\\eta(NX^2+N^{1/3}X^{7/3})$. Both signs are included, with no relation between $N$ and $X$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#thm-brs-input", target="_top"];
  "cor:brs-cumulative" [label="Corollary 2.2\nCumulative frequency range\n[Pending]", tooltip="For real $R,Y\\ge1$, the sum over $1\\le|r|\\le R$ is $\\ll_\\eta(RY)^\\eta(RY^2+R^{1/3}Y^{7/3})$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-brs-cumulative", target="_top"];
  "prop:rectangular" [label="Proposition 2.3\nRectangular second moment\n[Pending]", tooltip="For $M,N,X\\ge1$, $\\sum_{|m|\\le M,\\ |n|\\le N,\\ (m,n)\\ne(0,0)}|A_X(m,n)|^2\\ll_\\varepsilon(MNX)^\\varepsilon\\{MNX^2+(MN)^{1/3}X^{7/3}\\}$. The axes and all signs are included.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#prop-rectangular", target="_top"];
  "cor:shell" [label="Corollary 2.4\nNormalized shell moments\n[Pending]", tooltip="For $X\\ge2$ and $H\\ge1$, the shell $\\ell^2$ norm is $\\ll_\\eta(HX)^\\eta(X^{-1}H+X^{-5/6}H^{1/3})$. Its square is $\\ll_\\eta(HX)^\\eta(X^{-2}H^2+X^{-5/3}H^{2/3})$, and $|a_X(k)|^2\\le1$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-shell", target="_top"];
  "lem:translation" [label="Lemma 2.5\nTranslation to Fourier tails\n[Pending]", tooltip="If $g\\in L^2(\\mathbb T^2)$ satisfies $\\|g(\\cdot+h)-g\\|_2^2\\le\\Lambda|h|_2^\\alpha$ for $|h|_2\\le1$, with $0<\\alpha\\le1$ and $\\Lambda\\ge0$, then $\\sum_{\\|k\\|_\\infty\\ge H}|\\widehat g(k)|^2\\le 2^{-\\alpha/2}\\Lambda H^{-\\alpha}/[2(1-1/\\pi)]$ for every real $H\\ge1$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#lem-translation", target="_top"];
  "lem:brackets" [label="Lemma 2.6\nPointwise brackets\n[Pending]", tooltip="For measurable $E\\subset\\mathbb T^2$ and $0<\\delta\\le1/8$, constructs smooth real $f_-\\le\\mathbf1_E\\le f_+$ at every point, with values in $[0,1]$. The integral error is at most $b_E(3\\delta)$; Fourier coefficients and shell norms gain $(1+\\delta H)^{-L}$ with boundary errors $b_E(3\\delta)$ and $b_E(3\\delta)^{1/2}$ respectively.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#lem-brackets", target="_top"];
  "lem:convex-geometry" [label="Lemma 2.7\nConvex geometry and Fourier decay\n[Pending]", tooltip="For convex $\\Omega\\subset u+[0,1)^2$, $E=\\pi\\Omega$, perimeter $P$ and area $A$, proves $b_E(s)\\le4\\pi(Ps+s^2)$, $\\|\\mathbf1_E(\\cdot+h)-\\mathbf1_E\\|_2^2\\le P|h|_2$, Fourier tail $\\ll P/T$, and $|\\widehat{\\mathbf1_E}(k)|\\le\\min(A,P/(4|k|_2))$ for $k\\ne0$. Degenerate convex sets are included.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#lem-convex-geometry", target="_top"];
  "cor:convex-brackets" [label="Corollary 2.8\nConvex bracket bounds\n[Pending]", tooltip="For $0<\\delta\\le1/8$ and $H\\ge1$, with $b=P\\delta+\\delta^2$, the brackets have integral error $\\ll b$, shell norm $\\ll_L(1+\\delta H)^{-L}(P^{1/2}H^{-1/2}+b^{1/2})$, and coefficient bound $\\ll_L(1+\\delta H)^{-L}(P/H+b)$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-convex-brackets", target="_top"];
  "rem:tube-to-translation" [label="Remark 2.9\nTube bound to translation\n[Pending]", tooltip="For any measurable $E$ with $b_E(s)\\le C_0(Ps+s^2)$ for $0<s\\le1$, subdivision of a translation gives $\\|\\mathbf1_E(\\cdot+h)-\\mathbf1_E\\|_1\\le C_0P|h|_2$ for $|h|_2<1$. The separate convex slicing argument supplies the sharper constant used in (2.20).", shape="box", style="rounded,dashed,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#rem-tube-to-translation", target="_top"];
  "prop:identities" [label="Proposition 3.1\nThree Fourier identities\n[Pending]", tooltip="For $X\\ge2$, smooth counting error is $\\sum_{k\\ne0}\\widehat f(k)a_X(k)$, smooth difference-distribution error is $\\sum_{k\\ne0}\\widehat f(k)|a_X(k)|^2$, and for every measurable $E$ the translation variance is $\\sum_{k\\ne0}|\\widehat{\\mathbf1_E}(k)|^2|a_X(k)|^2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#prop-identities", target="_top"];
  "rem:overlap" [label="Remark 3.2\nOverlap identity\n[Pending]", tooltip="For $C_E(v)=\\int\\mathbf1_E(x)\\mathbf1_E(x+v)\\,dx$, direct expansion gives $\\mathcal V_X(E)=\\int C_E\\,d\\nu_X-|E|^2$. The variance theorem uses the Fourier variance identity directly, independently of the difference-distribution theorem.", shape="box", style="rounded,dashed,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#rem-overlap", target="_top"];
  "lem:dyadic" [label="Lemma 4.1\nDyadic summation\n[Pending]", tooltip="Controls the dyadic sum of $H^s(1+\\delta H)^{-L}$ by $\\delta^{-s}$ for $s>0$ and by a constant for $s<0$, with $L>\\max(s,0)$ and $0<\\delta\\le1$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#lem-dyadic", target="_top"];
  "prop:smoothing" [label="Proposition 4.2\nConvex smoothing bound\n[Pending]", tooltip="At any $0<\\delta\\le1/8$, controls convex discrepancy by the boundary error $b=P\\delta+\\delta^2$ and the Fourier contributions with scales $X^{-1}\\delta^{-1/2}$ and $X^{-5/6}$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#prop-smoothing", target="_top"];
  "prop:coordinate-separation" [label="Proposition 4.3\nCoordinate-separation bound\n[Pending]", tooltip="For convex sets in a translated unit square, gives the absolute-constant bound $D_X(\\pi\\Omega)\\ll X^{-2}+\\min(w_1,w_2)\\ll X^{-2}+P(\\Omega)$ for $X\\ge2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#prop-coordinate-separation", target="_top"];
  "cor:small-perimeter-sharp" [label="Corollary 4.4\nSharp small-perimeter order\n[Pending]", tooltip="For real $X\\ge4$ and $0\\le p\\le X^{-1}$, the largest discrepancy among convex sets of perimeter at most p has order $p+X^{-2}$, with absolute constants.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-small-perimeter-sharp", target="_top"];
  "rem:positive-area" [label="Remark 4.5\nPositive-area obstruction\n[Pending]", tooltip="A thin rectangle containing many diagonal reciprocal points has discrepancy $\\gg X^{-1}$ while its perimeter contribution is $O(X^{-4/3})$, so the baseline term in Theorem 1.1 remains necessary even for positive-area convex bodies.", shape="box", style="rounded,dashed,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#rem-positive-area", target="_top"];
  "cor:well-shaped" [label="Corollary 4.6\nWell-shaped sets\n[Pending]", tooltip="For the Euclidean definition of gamma-well-shapedness inside $[0,1)^2$, gives discrepancy $\\ll_{\\varepsilon}(1+\\gamma)^{2/3}X^{-2/3+\\varepsilon}$, uniformly for $\\gamma\\ge0$ and $X\\ge2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-well-shaped", target="_top"];
  "rem:koch" [label="Remark 4.7\nKoch snowflake example\n[Pending]", tooltip="Applies the boundary theorem to a Koch snowflake inside the unit square, with $\\alpha=2-\\log 4/\\log 3$, giving exponent $0.539\\ldots$; the same domain is not gamma-well-shaped for any finite gamma.", shape="box", style="rounded,dashed,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#rem-koch", target="_top"];
  "rem:topological-boundary" [label="Remark 4.8\nTopological boundary matters\n[Pending]", tooltip="The finite set $E=\\mathcal P_X$ has indicator zero almost everywhere but discrepancy one. Thus almost-everywhere or distributional-perimeter information cannot replace the stated pointwise/topological boundary control.", shape="box", style="rounded,dashed,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#rem-topological-boundary", target="_top"];
  "lem:arc-brackets" [label="Lemma 5.1\nArc brackets\n[Pending]", tooltip="An arc of length $a$ admits smooth upper and lower brackets with integral error at most $4\\delta$. With $a'=\\min(1,a+4\\delta)$, their coefficients are $\\ll_L\\min\\{a',(1+|m|)^{-1}\\}(1+\\delta|m|)^{-L}$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#lem-arc-brackets", target="_top"];
  "cor:difference-shrinking" [label="Corollary 5.2\nShrinking difference sets\n[Pending]", tooltip="For $0<\\kappa<1$, a fixed positive-area convex shape at linear scale $t\\ge X^{-1+\\kappa}$ has relative difference-count error $O(X^{-\\kappa/2})$, uniformly in position and orientation within a translated unit square. Products of arcs have the same error when their area is at least $X^{-2+\\kappa}$. Both conclusions hold with and without diagonal pairs under the corresponding normalizations.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-difference-shrinking", target="_top"];
  "lem:one-point" [label="Lemma 5.3\nOne-point variance\n[Pending]", tooltip="If every translate of a measurable set contains at most one point, its normalized-count variance is $|E|/N_X-|E|^2$. A sufficient condition is containment, after projection, in a strip of width below $X^{-2}$; the stated small-perimeter, narrow-rectangle and small-disc cases follow.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#lem-one-point", target="_top"];
  "cor:variance-shrinking" [label="Corollary 5.4\nMost translates\n[Pending]", tooltip="For a fixed positive-area convex shape at scale $t\\ge X^{-1+\\kappa}$, the centers with relative count error greater than $\\lambda$ have measure $\\ll_{K_0,\\kappa}\\lambda^{-2}X^{-3\\kappa/2}$, uniformly over admissible rotations and scales, for $0<\\kappa<1$ and $0<\\lambda\\le1$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-variance-shrinking", target="_top"];
  "cor:simultaneous" [label="Corollary 5.5\nAll radii simultaneously\n[Pending]", tooltip="For $r_0\\le r\\le1/4$, a single exceptional set has measure $\\ll_\\varepsilon\\lambda^{-3}X^\\varepsilon(X^{-2}r_0^{-2}+X^{-5/3}r_0^{-2/3})$ and outside it every disc count has relative error $O(\\lambda)$. Open and closed discs are included. Taking $r_0=X^{-1+\\kappa}$ and $\\lambda=X^{-\\kappa/3}$ yields exceptional measure $\\ll_\\kappa X^{-\\kappa/2}$ for sufficiently large $X$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#cor-simultaneous", target="_top"];
  "external:BRS-theorem-1-3" [label="BRS, Theorem 1.3", tooltip="The fixed-height signed-frequency second moment used as Theorem 2.1.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-BRS-theorem-1-3", target="_top"];
  "external:Xi-selberg-identity" [label="Xi, Selberg identity", tooltip="Elementary proof cited for equation (2.4); v39 gives no numbered locator for this citation.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-Xi-selberg-identity", target="_top"];
  "external:IK-equation-1-81" [label="IK, (1.81)", tooltip="For each positive eta, tau(v)<<_eta v^eta.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-IK-equation-1-81", target="_top"];
  "external:IK-equation-3-2" [label="IK, (3.2)", tooltip="The divisor expression for Ramanujan sums used to bound the coordinate axes.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-IK-equation-3-2", target="_top"];
  "external:HW-theorem-330" [label="Hardy-Wright, Theorem 330", tooltip="Mertens's estimate gives N_X=(3/pi^2)X^2+O(X log X).", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-HW-theorem-330", target="_top"];
  "external:Grafakos-section-3-2-2" [label="Grafakos, Section 3.2.2", tooltip="The L2 norm is the sum of squared Fourier coefficients.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-Grafakos-section-3-2-2", target="_top"];
  "external:Grafakos-sections-3-3-2-and-3-3-3" [label="Grafakos, Sections 3.3.2-3.3.3", tooltip="Rapid coefficient decay and absolute uniform Fourier inversion for smooth torus functions.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-Grafakos-sections-3-3-2-and-3-3-3", target="_top"];
  "external:Grafakos-section-3-1-2" [label="Grafakos, Section 3.1.2", tooltip="Convolution multiplies Fourier coefficients.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-Grafakos-section-3-1-2", target="_top"];
  "eq:point-fourier" [label="Point-set Fourier transform", tooltip="The finite exponential sum over $\\mathcal P_X$ equals $A_X(m,n)=\\sum_{c\\le X}S(m,n;c)$, with every point counted once and the modulus-one point represented by $S(m,n;1)=1$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-point-fourier", target="_top"];
  "step:cardinality-comparison" [label="Cardinality comparison", tooltip="The point count is $N_X=\\sum_{c\\le X}\\varphi(c)=(3/\\pi^2)X^2+O(X\\log X)$; in particular $N_X\\asymp X^2$ for $X\\ge2$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-cardinality-comparison", target="_top"];
  "step:normalized-coefficient-bound" [label="Normalized coefficient bound", tooltip="The normalized coefficients satisfy $a_X(k)=N_X^{-1}\\sum_{z\\in\\mathcal P_X}e(k\\cdot z)$, $a_X(0)=1$ and $|a_X(k)|\\le1$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-normalized-coefficient-bound", target="_top"];
  "step:kloosterman-symmetries" [label="Kloosterman symmetries", tooltip="The elementary changes of variables give $S(m,n;c)=S(n,m;c)$ and $S(-m,-n;c)=S(m,n;c)$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-kloosterman-symmetries", target="_top"];
  "eq:selberg" [label="Selberg identity", tooltip="For integers $m,n$ and $c\\ge1$, $S(m,n;c)=\\sum_{d\\mid\\gcd(m,n,c)}d\\,S(mn/d^2,1;c/d)$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-selberg", target="_top"];
  "eq:selberg-summed" [label="Cumulative Selberg identity", tooltip="For $mn\\ne0$, summing Selberg's identity over the modulus gives $A_X(m,n)=\\sum_{d\\mid\\gcd(|m|,|n|),\\,d\\le X}d\\,A_{X/d}(mn/d^2,1)$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-selberg-summed", target="_top"];
  "step:divisor-small-power" [label="Divisor bound", tooltip="For every $\\eta>0$ and integer $v\\ge1$, $\\tau(v)\\ll_\\eta v^\\eta$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-divisor-small-power", target="_top"];
  "step:rectangular-divisor-reduction" [label="Off-axis divisor reduction", tooltip="Cauchy–Schwarz over divisors and at most $2\\tau(|r|)$ signed factorizations $uv=r$ reduce the off-axis second moment to $\\sum_{d\\le\\min(M,N,X)}d^2\\sum_{1\\le|r|\\le MN/d^2}|A_{X/d}(r,1)|^2$. The cumulative input applies with $R=MN/d^2\\ge1$, $Y=X/d\\ge1$; the divisor sums have weights $d^{-2}$ and $d^{-1}$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-rectangular-divisor-reduction", target="_top"];
  "step:axis-ramanujan-bound" [label="Axis bound", tooltip="The Ramanujan formula $S(0,n;c)=\\sum_{d\\mid\\gcd(c,n)}d\\mu(c/d)$ gives $|A_X(0,n)|\\le X\\tau(|n|)$; symmetry gives the corresponding bound on the other axis. The divisor estimate then bounds both axes by $O_\\eta(MNX^2(MN)^{2\\eta})$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-axis-ramanujan-bound", target="_top"];
  "step:fourier-translation-rule" [label="Fourier translation rule", tooltip="With $\\widehat f(k)=\\int_{\\mathbb T^2}f(x)e(-k\\cdot x)\\,dx$, one has $\\widehat{f(\\cdot+h)}(k)=e(k\\cdot h)\\widehat f(k)$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-fourier-translation-rule", target="_top"];
  "eq:mollifier-decay" [label="Mollifier decay", tooltip="For $0<\\delta\\le1/8$, the periodized mollifier $\\rho_\\delta$ is nonnegative, has integral one and support within distance $\\delta$ of zero. Integration by parts proves $|\\widehat{\\rho_\\delta}(k)|\\ll_L(1+\\delta\\|k\\|_\\infty)^{-L}$ for every $L>0$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-mollifier-decay", target="_top"];
  "step:boundary-crossing" [label="Boundary-crossing argument", tooltip="A shortest lifted segment joining a point of $E$ to a point of $E^c$ meets $\\partial E$. Applied to the inner and outer sets used for smoothing, this places their indicator differences from $\\mathbf1_E$ within the $3\\delta$ boundary neighborhood.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-boundary-crossing", target="_top"];
  "eq:bracket-difference-norms" [label="Bracket difference norms", tooltip="For the inner and outer sets $E_\\pm$, $\\|\\mathbf1_{E_\\pm}-\\mathbf1_E\\|_1\\le b_E(3\\delta)$ and $\\|\\mathbf1_{E_\\pm}-\\mathbf1_E\\|_2^2\\le b_E(3\\delta)$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-bracket-difference-norms", target="_top"];
  "step:convex-boundary-geometry" [label="Convex boundary geometry", tooltip="For a convex body in a unit square, the boundary is a rectifiable Jordan curve of length $P\\le4$. The arc covering argument shows that it has measure zero, while convexity gives $\\operatorname{int}\\overline\\Omega\\subset\\Omega$. Thus $\\mathbf1_\\Omega=\\mathbf1_{\\overline\\Omega}$ almost everywhere. Degenerate sets are handled separately.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-convex-boundary-geometry", target="_top"];
  "eq:convex-tube" [label="Convex boundary tube", tooltip="For $E=\\pi\\Omega$ with convex $\\Omega\\subset u+[0,1)^2$, $b_E(s)\\le4\\pi(Ps+s^2)$ for $0<s\\le1$. A cover of the Euclidean boundary is projected to the torus, using $\\partial E\\subset\\pi(\\partial\\overline\\Omega)$ and that projection does not increase measure.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-convex-tube", target="_top"];
  "eq:convex-translation" [label="Convex translation", tooltip="Parallel-line slicing gives $|(K+h)\\triangle K|\\le P|h|_2$, since the perpendicular width is at most $P/2$. Periodization then yields $\\|\\mathbf1_E(\\cdot+h)-\\mathbf1_E\\|_2^2\\le P|h|_2$ on the torus for every $h\\in\\mathbb R^2$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-convex-translation", target="_top"];
  "eq:convex-tail" [label="Convex Fourier tail", tooltip="The translation estimate with $\\Lambda=P$ and $\\alpha=1$ in Lemma 2.5 yields $\\sum_{\\|k\\|_\\infty\\ge T}|\\widehat{\\mathbf1_E}(k)|^2\\ll P/T$ for $T\\ge1$, and hence the same bound on a dyadic shell.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-convex-tail", target="_top"];
  "eq:convex-pointwise" [label="Convex coefficient bound", tooltip="For $k\\ne0$, the special translation $h=k/(2|k|_2^2)$ has multiplier $-2$ and gives $|\\widehat{\\mathbf1_E}(k)|\\le P/(4|k|_2)$. Combining this with the trivial area bound gives $\\min\\{A,P/(4|k|_2)\\}$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-convex-pointwise", target="_top"];
  "eq:identity-mu" [label="Counting identity", tooltip="For smooth $f$, $\\int f\\,d\\mu_X-\\int f=\\sum_{k\\ne0}\\widehat f(k)a_X(k)$, with absolute convergence. It follows by pointwise smooth Fourier inversion and a finite average over $\\mathcal P_X$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-identity-mu", target="_top"];
  "eq:identity-nu" [label="Difference identity", tooltip="For smooth $f$, $\\int f\\,d\\nu_X-\\int f=\\sum_{k\\ne0}\\widehat f(k)|a_X(k)|^2$, with absolute convergence. The finite double exponential sum factors as $a_X(k)\\overline{a_X(k)}$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-identity-nu", target="_top"];
  "eq:identity-variance" [label="Variance identity", tooltip="For every measurable $E$, the finite reflected-translate sum $Z_E(u)=\\mu_X(u+E)-|E|$ has nonzero Fourier coefficients $a_X(-k)\\widehat{\\mathbf1_E}(-k)$. Parseval gives $\\mathcal V_X(E)=\\sum_{k\\ne0}|\\widehat{\\mathbf1_E}(k)|^2|a_X(k)|^2$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-identity-variance", target="_top"];
  "step:variance-null-set-invariance" [label="Variance and null sets", tooltip="The variance identity depends only on the $L^2$ class of $\\mathbf1_E$, so changing $E$ on a null set leaves $\\mathcal V_X(E)$ unchanged. In particular, boundary choices do not affect convex-set variance.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-variance-null-set-invariance", target="_top"];
  "step:indicator-translation-norms" [label="Indicator translation norms", tooltip="For an indicator, $\\|\\mathbf1_E(\\cdot+h)-\\mathbf1_E\\|_2^2=\\|\\mathbf1_E(\\cdot+h)-\\mathbf1_E\\|_1=|(E-h)\\triangle E|$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-indicator-translation-norms", target="_top"];
  "step:pointwise-discrepancy-reduction" [label="Pointwise bracket reduction", tooltip="Pointwise upper and lower brackets reduce discrepancy to the larger smooth counting Fourier sum plus their integral error. The same reduction applies to general measurable sets.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-pointwise-discrepancy-reduction", target="_top"];
  "step:coordinate-counting" [label="Coordinate counting", tooltip="Distinct points have distinct coordinates; their lifts have coordinate spacing at least $X^{-2}$. A width-$w_j$ interval therefore contains at most $1+w_jX^2$ lifted points.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-coordinate-counting", target="_top"];
  "eq:combined-small" [label="Combined discrepancy bound (4.4)", tooltip="Takes the smaller of the coordinate-width bound and the perimeter-sensitive Fourier bound.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-combined-small", target="_top"];
  "step:cardinality-upper" [label="Elementary cardinality bound", tooltip="The identity $N_X=\\sum_{c\\le X}\\varphi(c)$ and $\\varphi(c)\\le c$ give $N_X\\le X^2$ for $X\\ge1$. This elementary upper bound is used in the small-perimeter examples and repeated in the lower distance estimate.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-cardinality-upper", target="_top"];
  "step:short-perimeter-diagonal-lower" [label="Short diagonal lower bound", tooltip="A segment starting at $(1/X,1/X)$ captures both one point and a number proportional to $pX^2$; division by $N_X$ gives the two terms in the lower bound. Integer parts handle real heights.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-short-perimeter-diagonal-lower", target="_top"];
  "step:boundary-fourier-control" [label="Boundary Fourier control", tooltip="A path crossing the topological boundary bounds the symmetric difference by $B|h|_2^{\\alpha}$; the translation lemma and smooth brackets then give shell norms uniformly in alpha.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-boundary-fourier-control", target="_top"];
  "step:boundary-uniform-dyadic" [label="Uniform boundary dyadic sums", tooltip="Uses the explicit geometric-series constants for exponents in compact positive ranges, and treats $\\beta=1/3-\\alpha/2$ directly through zero with a logarithmic cutoff factor.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-boundary-uniform-dyadic", target="_top"];
  "eq:general-smoothing" [label="General boundary smoothing (4.6)", tooltip="Combines the pointwise discrepancy reduction, boundary-based bracket norms, arithmetic shell estimate and uniform dyadic sums before optimizing delta.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-general-smoothing", target="_top"];
  "step:well-shaped-torus-tube" [label="Well-shaped torus tubes", tooltip="Separates a strip near the unit-square boundary from interior discs to obtain $b_{\\pi\\Omega}(s)\\le(8+4\\gamma)s$ at small s, and an admissible global constant $B=8(1+\\gamma)$ for alpha one.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-well-shaped-torus-tube", target="_top"];
  "step:koch-tube" [label="Koch boundary tube control", tooltip="The construction arcs give a covering by $O((\\ell/s)^d)$ discs of radius $O(s)$, yielding boundary-tube order at most $s^{2-d}$; the source's dimension d also obstructs a linear tube bound.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-koch-tube", target="_top"];
  "external:BRS-section-3-1" [label="BRS Section 3.1", tooltip="Definition of well-shaped sets", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-BRS-section-3-1", target="_top"];
  "external:LP-section-1" [label="LP Section 1", tooltip="Koch construction and Minkowski dimension", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-LP-section-1", target="_top"];
  "step:difference-convex-proof" [label="Convex difference component", tooltip="Bracket the convex indicator pointwise, use the nonnegative coefficients $|a_X(k)|^2$ in the difference identity, sum the squared shell estimates, and take $\\delta=(8X)^{-1}$ to obtain the convex clause of Theorem 1.5.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-difference-convex-proof", target="_top"];
  "step:arc-indicator-coefficients" [label="Arc coefficient calculation", tooltip="Direct integration gives the nonzero coefficient of an arc indicator as an endpoint exponential difference divided by $2\\pi i m$. Its modulus is bounded by the smaller of the arc length and $(\\pi|m|)^{-1}$; the zero coefficient is the length.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-arc-indicator-coefficients", target="_top"];
  "step:difference-box-proof" [label="Rectangle difference component", tooltip="Use products of arc brackets and dyadic blocks in each frequency separately. Proposition 2.3 and the resulting one-variable sums, with $\\delta=(16X^2)^{-1}$, give the area-dependent rectangle clause of Theorem 1.5.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-difference-box-proof", target="_top"];
  "eq:diagonal-removal" [label="Diagonal removal", tooltip="The exact relation $\\nu_X=(1-N_X^{-1})\\nu_X^*+N_X^{-1}\\delta_0$ implies that the two probability measures differ on any measurable set by at most $N_X^{-1}\\ll X^{-2}$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-diagonal-removal", target="_top"];
  "step:variance-convex-proof" [label="Convex variance component", tooltip="Handle sets below the one-point threshold by the exact identity. Otherwise split at frequency $T=X^2/P$, use the convex Fourier tail above $T$, and pair the pointwise coefficient bound with the squared shell estimate below $T$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-variance-convex-proof", target="_top"];
  "step:variance-disc-proof" [label="Disc variance component", tooltip="Apply the established convex variance estimate with area $\\pi r^2$ and perimeter $2\\pi r$; discs of radius at most $1/4$ fit in a translated unit square.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-variance-disc-proof", target="_top"];
  "step:variance-box-proof" [label="Rectangle variance component", tooltip="Use the one-point identity for a side below $X^{-2}$. Otherwise factor the squared indicator coefficients, sum separate frequency blocks against Proposition 2.3, and split the one-variable sums at the reciprocal side lengths.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-variance-box-proof", target="_top"];
  "eq:FX" [label="Empty rectangle", tooltip="For $X>9$, the rectangle $[2X^{-1/2},3X^{-1/2}]\\times[\\tfrac15X^{-1/2},\\tfrac14X^{-1/2}]$ has area $1/(20X)$ and contains no modular-inverse point. The proof separates points with $ab=1$ from those with $ab=1+jc$, $j\\ge1$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-FX", target="_top"];
  "eq:distance-tail" [label="Distance tail", tooltip="An empty disc forces normalized-count deviation $\\pi r^2$. Chebyshev's inequality and the disc variance therefore bound the measure of $\\{d_X>r\\}$ by $\\ll_\\varepsilon X^\\varepsilon(X^{-2}r^{-2}+X^{-5/3}r^{-2/3})$ for $0<r\\le1/4$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-distance-tail", target="_top"];
  "eq:distance-max" [label="Distance cutoff", tooltip="For any fixed $0<\\kappa\\le1/4$ and sufficiently large $X$, Corollary 1.3 ensures that every disc of radius $X^{-1/2+\\kappa}$ contains a point. Hence $d_X(u)<X^{-1/2+\\kappa}$ for every center.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#eq-distance-max", target="_top"];
  "step:distance-upper" [label="Distance upper bound", tooltip="Use the layer-cake formula, the trivial tail bound below $X^{-1}$, the variance tail up to $X^{-1/2+\\kappa}$, and the vanishing tail beyond it. The integral of $r^{s-3}$ produces the three cases $s<2$, $s=2$, and $s>2$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-distance-upper", target="_top"];
  "step:distance-lower" [label="Distance lower bounds", tooltip="A union of $N_X$ discs covering at most half the torus gives a lower bound $\\gg_sX^{-s}$. The middle quarter of the explicit empty rectangle has measure $\\asymp X^{-1}$ and distance $\\gg X^{-1/2}$ from the point set, giving $\\gg_sX^{-1-s/2}$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#step-distance-lower", target="_top"];
  "external:BRS-section-1-2" [label="BRS, Section 1.2", tooltip="BRS Section 1.2 supplies the credited empty-box construction and the contextual discussion of smoothing the modulus cutoff.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_i/blob/main/INVENTORY.md#external-BRS-section-1-2", target="_top"];
